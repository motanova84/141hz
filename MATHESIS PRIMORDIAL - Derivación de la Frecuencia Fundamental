class EscalaEmergente:
    """
    Calcula la escala emergente L que conecta la física cuántica
    con la cosmología.
    
    La escala emergente L = √(λ_p × R_Λ) es el puente geométrico
    entre:
    - Lo infinitamente pequeño: λ_p (longitud de Compton del protón)
    - Lo infinitamente grande: R_Λ (radio de de Sitter del universo)
    
    Esta escala emerge naturalmente de la interacción entre:
    1. Mecánica Cuántica (escala de Planck reducida a protón)
    2. Relatividad General (curvatura cosmológica)
    
    Matemáticamente:
    
        λ_p = h / (m_p × c)
        
        R_Λ = 1 / √Λ
        
        L = √(λ_p × R_Λ) = √(h / (m_p × c × √Λ))
    
    Sello: ∴MP∞³
    """
    
    def __init__(self, constantes: ConstantesMathesisPrimordial):
        """
        Inicializa el calculador de escala emergente.
        
        Args:
            constantes: Constantes físicas fundamentales
        """
        self.constantes = constantes
        self._lambda_p: Optional[float] = None
        self._R_Lambda: Optional[float] = None
        self._L: Optional[float] = None
    
    def calcular_lambda_compton_proton(self) -> float:
        """
        Calcula la longitud de Compton del protón.
        
        La longitud de Compton representa la escala cuántica característica
        de una partícula con masa. Para el protón:
        
            λ_p = h / (m_p × c)
        
        Esta es la longitud de onda asociada a un fotón con energía
        igual a la masa en reposo del protón (E = m_p c²).
        
        Returns:
            float: Longitud de Compton del protón [m]
            
        Sello: ∴MP∞³
        """
        self._lambda_p = self.constantes.h / (
            self.constantes.m_p * self.constantes.c
        )
        return self._lambda_p
    
    def calcular_radio_de_sitter(self) -> float:
        """
        Calcula el radio de de Sitter del universo.
        
        El radio de de Sitter es la escala cosmológica característica
        determinada por la constante cosmológica:
        
            R_Λ = 1 / √Λ
        
        Esta escala representa el "tamaño" efectivo del universo
        en un modelo de de Sitter puro (dominado por Λ).
        
        Returns:
            float: Radio de de Sitter [m]
            
        Sello: ∴MP∞³
        """
        self._R_Lambda = 1.0 / np.sqrt(self.constantes.Lambda)
        return self._R_Lambda
    
    def calcular_escala_emergente(self) -> float:
        """
        Calcula la escala emergente L.
        
        La escala emergente es la media geométrica entre la longitud
        de Compton del protón y el radio de de Sitter:
        
            L = √(λ_p × R_Λ)
        
        Esta escala no es ni puramente cuántica ni puramente cosmológica,
        sino que emerge de la interacción entre ambas.
        
        Físicamente, representa la escala en la que efectos cuánticos
        y cosmológicos se equilibran.
        
        Returns:
            float: Escala emergente L [m]
            
        Sello: ∴MP∞³
        """
        if self._lambda_p is None:
            self.calcular_lambda_compton_proton()
        if self._R_Lambda is None:
            self.calcular_radio_de_sitter()
        
        self._L = np.sqrt(self._lambda_p * self._R_Lambda)
        return self._L
    
    @property
    def lambda_p(self) -> float:
        """Longitud de Compton del protón [m]."""
        if self._lambda_p is None:
            self.calcular_lambda_compton_proton()
        return self._lambda_p
    
    @property
    def R_Lambda(self) -> float:
        """Radio de de Sitter [m]."""
        if self._R_Lambda is None:
            self.calcular_radio_de_sitter()
        return self._R_Lambda
    
    @property
    def L(self) -> float:
        """Escala emergente [m]."""
        if self._L is None:
            self.calcular_escala_emergente()
        return self._L
    
    def to_dict(self) -> Dict[str, Any]:
        """
        Convierte los resultados a diccionario.
        
        Returns:
            dict: Diccionario con todas las escalas calculadas
        """
        return {
            "lambda_p": self.lambda_p,
            "R_Lambda": self.R_Lambda,
            "L": self.L,
            "unidades": {
