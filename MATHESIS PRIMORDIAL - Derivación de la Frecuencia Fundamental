    antes de considerar efectos topológicos de red.
    
    Valor esperado: f_bare ≈ 132.06 Hz
    
    Sello: ∴MP∞³
    """
    
    def __init__(self, escala: EscalaEmergente):
        """
        Inicializa el calculador de frecuencia bare.
        
        Args:
            escala: Calculador de escala emergente
        """
        self.escala = escala
        self._f_bare: Optional[float] = None
    
    def calcular(self) -> float:
        """
        Calcula la frecuencia bare.
        
        La frecuencia bare se obtiene de la relación de dispersión
        fundamental para una onda en el espacio-tiempo:
        
            f = c / λ
        
        Donde λ es la longitud de onda característica. Para un
        sistema con escala L, la longitud de onda es:
        
            λ = 2π × L
        
        Por lo tanto:
        
            f_bare = c / (2π × L)
        
        Returns:
            float: Frecuencia bare [Hz]
            
        Sello: ∴MP∞³
        """
        L = self.escala.L
        self._f_bare = self.escala.constantes.c / (2.0 * np.pi * L)
        return self._f_bare
    
    @property
    def f_bare(self) -> float:
        """Frecuencia bare [Hz]."""
        if self._f_bare is None:
            self.calcular()
        return self._f_bare
    
    def to_dict(self) -> Dict[str, Any]:
        """
        Convierte el resultado a diccionario.
        
        Returns:
            dict: Diccionario con la frecuencia bare
        """
        return {
            "f_bare": self.f_bare,
            "unidad": "Hz",
            "descripcion": "Frecuencia bare (sin factor topológico)",
            "ecuacion": "f_bare = c / (2π × L)",
            "sello": "∴MP∞³"
        }


