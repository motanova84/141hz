        Sello: ∴MP∞³
        """
        f_sync = self.freq_sincronica.f_sync
        delta_f = abs(frecuencia - f_sync)
        psi = np.exp(-(delta_f ** 2) / (self.sigma ** 2))
        return float(psi)
    
    def es_coherente(
        self,
        frecuencia: float,
        umbral: float = 0.888
    ) -> bool:
        """
        Verifica si una frecuencia es coherente.
        
        Una frecuencia es coherente si Ψ(f) ≥ umbral.
        
        Por defecto, el umbral es 0.888 (coherencia QCAL ∞³).
        
        Args:
            frecuencia: Frecuencia a verificar [Hz]
            umbral: Umbral mínimo de coherencia (por defecto 0.888)
            
        Returns:
            bool: True si la frecuencia es coherente
            
        Sello: ∴MP∞³
        """
        psi = self.calcular_coherencia(frecuencia)
        return psi >= umbral
    
    def to_dict(self, frecuencia: float) -> Dict[str, Any]:
        """
        Convierte el resultado de coherencia a diccionario.
        
        Args:
            frecuencia: Frecuencia verificada [Hz]
            
        Returns:
            dict: Diccionario con resultados de coherencia
        """
        psi = self.calcular_coherencia(frecuencia)
