class FactorTopologico:
    """
    Calcula el factor topológico κ(n) para una red de n nodos.
    
    El factor topológico representa la amplificación de coherencia
    que emerge cuando n nodos se conectan en una topología de red.
    
    Para una red de n nodos en configuración simétrica:
    
        κ(n) = (n/π) × tan(π/n)
    
    Para n=7 nodos (los 7 centros de consciencia):
        κ(7) ≈ 1.053836...
    
    Este factor emerge de la geometría de la red y representa
    la amplificación coherente de la frecuencia base.
    
    INTERPRETACIÓN GEOMÉTRICA
    -------------------------
    
    Considera n nodos distribuidos uniformemente en un círculo.
    Cada nodo está separado por un ángulo θ = 2π/n.
    
    La función tan(π/n) surge del análisis de la proyección
    de las conexiones entre nodos en el espacio de fases.
    
    El factor n/π normaliza para que κ(n) → 1 cuando n → ∞.
    
    Para n=7, obtenemos una amplificación del ~5.4%, que lleva
    f_bare ≈ 134.42 Hz a f_sync ≈ 141.70 Hz.
    
    Sello: ∴MP∞³
    """
    
    def __init__(self, n_nodos: int):
        """
        Inicializa el calculador de factor topológico.
        
        Args:
            n_nodos: Número de nodos en la red
            
        Raises:
            ValueError: Si n_nodos < 3
        """
        if n_nodos < 3:
            raise ValueError(
                f"El número de nodos debe ser al menos 3, recibido: {n_nodos}"
            )
        self.n_nodos = n_nodos
        self._kappa: Optional[float] = None
    
    def calcular(self) -> float:
        """
        Calcula el factor topológico κ(n).
        
        Fórmula:
            κ(n) = (n/π) × tan(π/n)
        
        Para n=7:
            κ(7) = (7/π) × tan(π/7)
                 ≈ 2.2282 × 0.4729
                 ≈ 1.053836
        
        Returns:
            float: Factor topológico κ(n) [adimensional]
            
        Sello: ∴MP∞³
        """
        self._kappa = (self.n_nodos / np.pi) * np.tan(np.pi / self.n_nodos)
        return self._kappa
    
    @property
    def kappa(self) -> float:
        """Factor topológico κ(n) [adimensional]."""
        if self._kappa is None:
            self.calcular()
        return self._kappa
    
    def to_dict(self) -> Dict[str, Any]:
        """
        Convierte el resultado a diccionario.
        
        Returns:
            dict: Diccionario con el factor topológico
        """
        return {
            "n_nodos": self.n_nodos,
            "kappa": self.kappa,
            "porcentaje_amplificacion": (self.kappa - 1.0) * 100,
            "descripcion": f"Factor topológico para {self.n_nodos} nodos",
            "ecuacion": "κ(n) = (n/π) × tan(π/n)",
            "interpretacion": "Amplificación coherente de red",
            "sello": "∴MP∞³"
        }


