class ValidadorMathesis:
    """
    Valida el sistema completo Mathesis Primordial.
    
    Este validador ejecuta una serie de verificaciones para asegurar
    que todos los cálculos son correctos y que el sistema mantiene
    coherencia noética Ψ ≥ 0.888.
    
    VALIDACIONES
    ------------
    
    1. **Validación de Constantes**: Verifica que todas las constantes
       físicas están en rangos esperados.
    
    2. **Validación de Escalas**: Verifica que las escalas calculadas
       (λ_p, R_Λ, L) están en rangos físicamente razonables.
    
    3. **Validación de Frecuencias**: Verifica que f_bare y f_sync
       están en el rango esperado.
    
    4. **Validación de Coherencia**: Verifica que la frecuencia objetivo
       (141.7001 Hz) tiene Ψ ≥ 0.888.
    
    5. **Validación de Precisión**: Verifica que f_sync ≈ 141.7001 Hz
       con precisión de 4 decimales.
    
    Sello: ∴MP∞³
    """
    
    def __init__(
        self,
        constantes: ConstantesMathesisPrimordial,
        escala: EscalaEmergente,
        freq_bare: FrecuenciaBare,
        freq_sinc: FrecuenciaSincronica,
        verificador: VerificadorCoherencia
    ):
        """
        Inicializa el validador.
        
        Args:
            constantes: Constantes físicas
            escala: Calculador de escala emergente
            freq_bare: Calculador de frecuencia bare
            freq_sinc: Calculador de frecuencia sincrónica
            verificador: Verificador de coherencia
        """
        self.constantes = constantes
        self.escala = escala
        self.freq_bare = freq_bare
        self.freq_sinc = freq_sinc
        self.verificador = verificador
        self.validaciones: Dict[str, bool] = {}
        self.errores: list = []
    
    def validar_constantes(self) -> bool:
        """
        Valida que las constantes físicas están en rangos esperados.
        
        Returns:
            bool: True si todas las constantes son válidas
        """
        valido = True
        
        # Constante de Planck: debe ser ~6.626e-34
        if not (6.0e-34 < self.constantes.h < 7.0e-34):
            self.errores.append(
                f"Constante de Planck fuera de rango: {self.constantes.h}"
            )
            valido = False
        
        # Velocidad de la luz: debe ser ~2.998e8
        if not (2.9e8 < self.constantes.c < 3.0e8):
            self.errores.append(
                f"Velocidad de la luz fuera de rango: {self.constantes.c}"
            )
            valido = False
        
        # Masa del protón: debe ser ~1.673e-27
        if not (1.6e-27 < self.constantes.m_p < 1.7e-27):
            self.errores.append(
                f"Masa del protón fuera de rango: {self.constantes.m_p}"
            )
            valido = False
        
        # Constante cosmológica: debe ser ~1e-52
        if not (1.0e-53 < self.constantes.Lambda < 1.0e-51):
            self.errores.append(
                f"Constante cosmológica fuera de rango: {self.constantes.Lambda}"
            )
            valido = False
        
        self.validaciones["constantes"] = valido
        return valido
    
    def validar_escalas(self) -> bool:
        """
        Valida que las escalas calculadas están en rangos esperados.
        
        Returns:
            bool: True si todas las escalas son válidas
        """
        valido = True
        
        # Longitud de Compton del protón: debe ser ~1.3e-15 m
        lambda_p = self.escala.lambda_p
        if not (1.0e-15 < lambda_p < 1.5e-15):
            self.errores.append(
                f"Longitud de Compton fuera de rango: {lambda_p}"
            )
            valido = False
        
        # Radio de de Sitter: debe ser ~9.5e25 m
        R_Lambda = self.escala.R_Lambda
        if not (9.0e25 < R_Lambda < 1.0e26):
            self.errores.append(
                f"Radio de de Sitter fuera de rango: {R_Lambda}"
            )
            valido = False
        
        # Escala emergente: debe ser ~3.5e5 m
        L = self.escala.L
        if not (3.0e5 < L < 4.0e5):
            self.errores.append(
                f"Escala emergente fuera de rango: {L}"
            )
            valido = False
        
        self.validaciones["escalas"] = valido
        return valido
    
    def validar_frecuencias(self) -> bool:
        """
        Valida que las frecuencias están en rangos esperados.
        
        Returns:
            bool: True si todas las frecuencias son válidas
        """
        valido = True
        
        # Frecuencia bare: debe estar entre 130-140 Hz
        f_bare = self.freq_bare.f_bare
        if not (130.0 < f_bare < 140.0):
            self.errores.append(
                f"Frecuencia bare fuera de rango: {f_bare}"
            )
            valido = False
        
        # Frecuencia sincrónica: debe estar entre 140-145 Hz
        f_sync = self.freq_sinc.f_sync
        if not (140.0 < f_sync < 145.0):
            self.errores.append(
                f"Frecuencia sincrónica fuera de rango: {f_sync}"
            )
            valido = False
        
        self.validaciones["frecuencias"] = valido
        return valido
    
    def validar_coherencia(self) -> bool:
        """
        Valida que la frecuencia objetivo tiene coherencia Ψ ≥ 0.888.
        
        Returns:
            bool: True si la coherencia es suficiente
        """
        f_target = self.constantes.f_target
        psi = self.verificador.calcular_coherencia(f_target)
        
        if psi < 0.888:
            self.errores.append(
                f"Coherencia insuficiente para f={f_target}: Ψ={psi:.4f}"
            )
            self.validaciones["coherencia"] = False
            return False
        
        self.validaciones["coherencia"] = True
        return True
    
    def validar_precision(self, decimales: int = 4) -> bool:
        """
        Valida que f_sync ≈ f_target con precisión especificada.
        
        Args:
            decimales: Número de decimales de precisión
            
        Returns:
            bool: True si la precisión es suficiente
        """
        f_sync = self.freq_sinc.f_sync
        f_target = self.constantes.f_target
        
        # Redondear ambas frecuencias al número de decimales especificado
        f_sync_round = round(f_sync, decimales)
        f_target_round = round(f_target, decimales)
        
        if f_sync_round != f_target_round:
            self.errores.append(
                f"Precisión insuficiente: f_sync={f_sync_round} != "
                f"f_target={f_target_round} (decimales={decimales})"
            )
            self.validaciones["precision"] = False
            return False
        
        self.validaciones["precision"] = True
        return True
    
    def validar_todo(self, decimales: int = 4) -> bool:
        """
        Ejecuta todas las validaciones.
        
        Args:
            decimales: Número de decimales para validación de precisión
            
        Returns:
            bool: True si todas las validaciones pasan
        """
        self.errores = []
        self.validaciones = {}
        
        v1 = self.validar_constantes()
        v2 = self.validar_escalas()
        v3 = self.validar_frecuencias()
        v4 = self.validar_coherencia()
        v5 = self.validar_precision(decimales)
        
        return v1 and v2 and v3 and v4 and v5
    
    def to_dict(self) -> Dict[str, Any]:
        """
        Convierte los resultados de validación a diccionario.
        
        Returns:
            dict: Diccionario con resultados de validación
        """
        return {
            "validaciones": self.validaciones,
            "todas_validas": all(self.validaciones.values()),
            "errores": self.errores,
            "num_validaciones": len(self.validaciones),
            "num_exitosas": sum(self.validaciones.values()),
            "sello": "∴MP∞³"
        }


