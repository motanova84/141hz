        "    \"\"\"\n",
        "    fig, ax = plt.subplots(figsize=(14, 8))\n",
        "    \n",
        "    # Escalas de frecuencia\n",
        "    frequencies = np.array([\n",
        "        OMEGA_FRAME_HZ,  # Frame-dragging (cosmológica)\n",
        "        1e-3,            # Milihertz (ondas gravitacionales muy bajas)\n",
