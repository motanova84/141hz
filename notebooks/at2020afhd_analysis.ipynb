        "## 📡 1. Datos Sintéticos de AT2020afhd\n",
        "\n",
        "Basados en los parámetros publicados en Science Advances (Pasham et al.)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def generate_synthetic_at2020afhd_data(duration_days=200, sampling_hours=6):\n",
        "    \"\"\"\n",
        "    Genera datos sintéticos de AT2020afhd basados en observaciones publicadas.\n",
        "    \n",
        "    Parámetros del modelo Lense-Thirring:\n",
        "    Ψ(t) = A·sin(ω·t + φ)·e^(-γt)\n",
        "    \n",
        "    Args:\n",
        "        duration_days: Duración total de las observaciones\n",
        "        sampling_hours: Intervalo de muestreo en horas\n",
        "    \n",
        "    Returns:\n",
        "        dict con 'time', 'xray_flux', 'radio_flux'\n",
        "    \"\"\"\n",
        "    # Tiempos de observación\n",
        "    dt_hours = sampling_hours\n",
        "    n_points = int(duration_days * 24 / dt_hours)\n",
        "    time_days = np.linspace(0, duration_days, n_points)\n",
        "    time_seconds = time_days * 24 * 3600\n",
        "    \n",
        "    # Parámetros del modelo Lense-Thirring\n",
        "    A_xray = 5e-11  # Amplitud X-ray (erg/cm²/s)\n",
        "    A_radio = 0.5   # Amplitud Radio (mJy)\n",
        "    omega = 2 * np.pi / PERIOD_SECONDS  # Frecuencia angular (rad/s)\n",
        "    phi = np.pi / 4  # Fase inicial\n",
        "    gamma = 1e-7  # Tasa de decaimiento (1/s)\n",
        "    \n",
        "    # Componente periódica con decaimiento exponencial (Lense-Thirring)\n",
        "    modulation = np.sin(omega * time_seconds + phi) * np.exp(-gamma * time_seconds)\n",
        "    \n",
        "    # Flujos X-ray y Radio\n",
        "    xray_baseline = 3e-11  # erg/cm²/s\n",
        "    radio_baseline = 1.0   # mJy\n",
        "    \n",
        "    xray_flux = xray_baseline + A_xray * modulation\n",
        "    radio_flux = radio_baseline + A_radio * modulation\n",
        "    \n",
        "    # Añadir ruido realista\n",
        "    xray_noise = np.random.normal(0, 0.3e-11, n_points)\n",
        "    radio_noise = np.random.normal(0, 0.05, n_points)\n",
        "    \n",
        "    xray_flux += xray_noise\n",
        "    radio_flux += radio_noise\n",
        "    \n",
        "    # Asegurar valores positivos\n",
        "    xray_flux = np.abs(xray_flux)\n",
        "    radio_flux = np.abs(radio_flux)\n",
        "    \n",
        "    return {\n",
        "        'time_days': time_days,\n",
        "        'time_seconds': time_seconds,\n",
        "        'xray_flux': xray_flux,\n",
        "        'radio_flux': radio_flux,\n",
        "        'modulation_clean': modulation\n",
        "    }\n",
        "\n",
        "# Generar datos\n",
        "print(\"⏳ Generando datos sintéticos de AT2020afhd...\")\n",
        "data = generate_synthetic_at2020afhd_data(duration_days=200, sampling_hours=6)\n",
        "print(f\"✅ Generados {len(data['time_days'])} puntos de datos\")\n",
        "print(f\"   Rango temporal: {data['time_days'][0]:.1f} - {data['time_days'][-1]:.1f} días\")\n",
        "print(f\"   Flujo X-ray medio: {np.mean(data['xray_flux']):.2e} erg/cm²/s\")\n",
        "print(f\"   Flujo Radio medio: {np.mean(data['radio_flux']):.2f} mJy\")"
      ]
    },
