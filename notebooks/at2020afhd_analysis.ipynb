      "source": [
        "## 🔍 3. Análisis de Periodograma (Lomb-Scargle)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def compute_lomb_scargle_periodogram(time_days, flux, min_period=5, max_period=50):\n",
        "    \"\"\"\n",
        "    Calcula el periodograma Lomb-Scargle para detectar periodicidades.\n",
        "    \n",
        "    Args:\n",
        "        time_days: Array de tiempos en días\n",
        "        flux: Array de flujos\n",
        "        min_period: Periodo mínimo a buscar (días)\n",
        "        max_period: Periodo máximo a buscar (días)\n",
        "    \n",
        "    Returns:\n",
        "        dict con 'frequency', 'power', 'periods', 'best_period', 'best_frequency'\n",
        "    \"\"\"\n",
        "    # Crear objeto LombScargle\n",
        "    ls = LombScargle(time_days, flux, normalization='standard')\n",
        "    \n",
        "    # Rango de frecuencias (1/días)\n",
        "    frequency = np.linspace(1/max_period, 1/min_period, 10000)\n",
        "    \n",
        "    # Calcular poder espectral\n",
        "    power = ls.power(frequency)\n",
        "    \n",
        "    # Encontrar el pico más fuerte\n",
        "    best_idx = np.argmax(power)\n",
        "    best_frequency = frequency[best_idx]\n",
        "    best_period = 1 / best_frequency\n",
        "    \n",
        "    # Calcular significancia estadística (FAP)\n",
        "    fap = ls.false_alarm_probability(power[best_idx])\n",
        "    \n",
        "    return {\n",
        "        'frequency': frequency,\n",
        "        'power': power,\n",
        "        'periods': 1/frequency,\n",
        "        'best_period': best_period,\n",
        "        'best_frequency': best_frequency,\n",
        "        'max_power': power[best_idx],\n",
        "        'fap': fap\n",
        "    }\n",
        "\n",
        "# Calcular periodogramas\n",
        "print(\"⏳ Calculando periodogramas Lomb-Scargle...\")\n",
        "print(\"\")\n",
        "\n",
        "# X-ray\n",
        "xray_periodogram = compute_lomb_scargle_periodogram(\n",
        "    data['time_days'], data['xray_flux'], min_period=5, max_period=50\n",
        ")\n",
        "\n",
        "print(\"🔴 X-RAY PERIODOGRAM:\")\n",
        "print(f\"   Periodo detectado: {xray_periodogram['best_period']:.2f} días\")\n",
        "print(f\"   Frecuencia: {xray_periodogram['best_frequency']:.6f} día⁻¹\")\n",
        "print(f\"   Poder máximo: {xray_periodogram['max_power']:.2f}\")\n",
        "print(f\"   FAP (False Alarm Probability): {xray_periodogram['fap']:.2e}\")\n",
        "print(\"\")\n",
        "\n",
        "# Radio\n",
        "radio_periodogram = compute_lomb_scargle_periodogram(\n",
        "    data['time_days'], data['radio_flux'], min_period=5, max_period=50\n",
        ")\n",
        "\n",
        "print(\"🟢 RADIO PERIODOGRAM:\")\n",
        "print(f\"   Periodo detectado: {radio_periodogram['best_period']:.2f} días\")\n",
        "print(f\"   Frecuencia: {radio_periodogram['best_frequency']:.6f} día⁻¹\")\n",
        "print(f\"   Poder máximo: {radio_periodogram['max_power']:.2f}\")\n",
        "print(f\"   FAP (False Alarm Probability): {radio_periodogram['fap']:.2e}\")\n",
        "print(\"\")\n",
        "print(\"✅ Periodogramas calculados exitosamente\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def plot_periodograms(xray_pg, radio_pg):\n",
        "    \"\"\"\n",
        "    Grafica los periodogramas Lomb-Scargle\n",
        "    \"\"\"\n",
        "    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 10))\n",
        "    \n",
        "    # X-ray periodogram\n",
        "    ax1.plot(xray_pg['periods'], xray_pg['power'], \n",
        "             color='#FF1744', linewidth=2, alpha=0.8)\n",
        "    ax1.axvline(xray_pg['best_period'], color='red', linestyle='--', \n",
        "                linewidth=2, label=f'Pico: {xray_pg[\"best_period\"]:.2f} días')\n",
        "    ax1.axvline(PERIOD_DAYS, color='blue', linestyle=':', \n",
        "                linewidth=2, alpha=0.7, label=f'Esperado: {PERIOD_DAYS} días')\n",
        "    ax1.set_xlabel('Periodo (días)', fontsize=12, fontweight='bold')\n",
        "    ax1.set_ylabel('Poder Espectral (normalizado)', fontsize=12, fontweight='bold')\n",
        "    ax1.set_title('Periodograma Lomb-Scargle: X-ray', fontsize=14, fontweight='bold')\n",
        "    ax1.legend(fontsize=11, loc='upper right')\n",
        "    ax1.grid(True, alpha=0.3)\n",
        "    ax1.set_xlim(5, 50)\n",
        "    \n",
        "    # Radio periodogram\n",
        "    ax2.plot(radio_pg['periods'], radio_pg['power'], \n",
        "             color='#00E676', linewidth=2, alpha=0.8)\n",
        "    ax2.axvline(radio_pg['best_period'], color='green', linestyle='--', \n",
        "                linewidth=2, label=f'Pico: {radio_pg[\"best_period\"]:.2f} días')\n",
        "    ax2.axvline(PERIOD_DAYS, color='blue', linestyle=':', \n",
        "                linewidth=2, alpha=0.7, label=f'Esperado: {PERIOD_DAYS} días')\n",
        "    ax2.set_xlabel('Periodo (días)', fontsize=12, fontweight='bold')\n",
        "    ax2.set_ylabel('Poder Espectral (normalizado)', fontsize=12, fontweight='bold')\n",
        "    ax2.set_title('Periodograma Lomb-Scargle: Radio', fontsize=14, fontweight='bold')\n",
        "    ax2.legend(fontsize=11, loc='upper right')\n",
        "    ax2.grid(True, alpha=0.3)\n",
        "    ax2.set_xlim(5, 50)\n",
        "    \n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "    \n",
        "    print(\"📈 Periodogramas confirmando la frecuencia de ~20 días\")\n",
        "\n",
        "# Graficar periodogramas\n",
        "plot_periodograms(xray_periodogram, radio_periodogram)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 🎯 4. Ajuste del Modelo Lense-Thirring\n",
        "\n",
        "Modelo de precesión con decaimiento exponencial:\n",
        "\n",
        "$$\\Psi(t) = A \\cdot \\sin(\\omega \\cdot t + \\phi) \\cdot e^{-\\gamma t}$$\n",
        "\n",
        "Donde:\n",
        "- $A$: Amplitud de la precesión\n",
        "- $\\omega$: Frecuencia angular de frame-dragging\n",
        "- $\\phi$: Fase inicial\n",
        "- $\\gamma$: Tasa de decaimiento"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def lense_thirring_model(t, A, omega, phi, gamma, baseline):\n",
        "    \"\"\"\n",
        "    Modelo de precesión Lense-Thirring con decaimiento exponencial.\n",
        "    \n",
        "    Args:\n",
        "        t: tiempo (segundos)\n",
        "        A: amplitud\n",
        "        omega: frecuencia angular (rad/s)\n",
        "        phi: fase inicial (rad)\n",
        "        gamma: tasa de decaimiento (1/s)\n",
        "        baseline: nivel base\n",
        "    \n",
        "    Returns:\n",
        "        Flujo modulado\n",
        "    \"\"\"\n",
        "    return baseline + A * np.sin(omega * t + phi) * np.exp(-gamma * t)\n",
        "\n",
        "def fit_lense_thirring_model(time_seconds, flux):\n",
        "    \"\"\"\n",
        "    Ajusta el modelo Lense-Thirring a los datos.\n",
        "    \"\"\"\n",
        "    # Parámetros iniciales (guess)\n",
        "    omega_guess = 2 * np.pi / PERIOD_SECONDS\n",
        "    A_guess = (np.max(flux) - np.min(flux)) / 2\n",
        "    baseline_guess = np.mean(flux)\n",
        "    phi_guess = 0\n",
        "    gamma_guess = 1e-7\n",
        "    \n",
        "    p0 = [A_guess, omega_guess, phi_guess, gamma_guess, baseline_guess]\n",
        "    \n",
        "    # Ajustar modelo\n",
        "    try:\n",
        "        popt, pcov = curve_fit(\n",
        "            lense_thirring_model, \n",
        "            time_seconds, \n",
        "            flux, \n",
        "            p0=p0,\n",
        "            maxfev=10000\n",
        "        )\n",
        "        \n",
        "        # Extraer parámetros\n",
        "        A_fit, omega_fit, phi_fit, gamma_fit, baseline_fit = popt\n",
        "        \n",
        "        # Calcular periodo ajustado\n",
        "        period_fit = 2 * np.pi / omega_fit\n",
        "        period_days_fit = period_fit / (24 * 3600)\n",
        "        \n",
        "        # Calcular R² (bondad de ajuste)\n",
        "        flux_fit = lense_thirring_model(time_seconds, *popt)\n",
        "        residuals = flux - flux_fit\n",
        "        ss_res = np.sum(residuals**2)\n",
        "        ss_tot = np.sum((flux - np.mean(flux))**2)\n",
        "        r_squared = 1 - (ss_res / ss_tot)\n",
        "        \n",
        "        return {\n",
        "            'params': popt,\n",
        "            'A': A_fit,\n",
        "            'omega': omega_fit,\n",
        "            'phi': phi_fit,\n",
        "            'gamma': gamma_fit,\n",
        "            'baseline': baseline_fit,\n",
        "            'period_seconds': period_fit,\n",
        "            'period_days': period_days_fit,\n",
        "            'flux_fit': flux_fit,\n",
        "            'r_squared': r_squared,\n",
        "            'success': True\n",
        "        }\n",
        "    except Exception as e:\n",
        "        print(f\"⚠️ Error en ajuste: {e}\")\n",
        "        return {'success': False}\n",
        "\n",
        "# Ajustar modelos\n",
        "print(\"⏳ Ajustando modelo Lense-Thirring a los datos...\")\n",
        "print(\"\")\n",
        "\n",
        "# X-ray\n",
        "xray_fit = fit_lense_thirring_model(data['time_seconds'], data['xray_flux'])\n",
        "\n",
        "if xray_fit['success']:\n",
        "    print(\"🔴 X-RAY FIT:\")\n",
        "    print(f\"   Amplitud A: {xray_fit['A']:.2e}\")\n",
        "    print(f\"   Frecuencia angular ω: {xray_fit['omega']:.6e} rad/s\")\n",
        "    print(f\"   Fase φ: {xray_fit['phi']:.3f} rad\")\n",
        "    print(f\"   Tasa decaimiento γ: {xray_fit['gamma']:.6e} 1/s\")\n",
        "    print(f\"   Periodo ajustado: {xray_fit['period_days']:.2f} días\")\n",
        "    print(f\"   R²: {xray_fit['r_squared']:.4f}\")\n",
        "    print(\"\")\n",
        "\n",
        "# Radio\n",
        "radio_fit = fit_lense_thirring_model(data['time_seconds'], data['radio_flux'])\n",
        "\n",
        "if radio_fit['success']:\n",
        "    print(\"🟢 RADIO FIT:\")\n",
        "    print(f\"   Amplitud A: {radio_fit['A']:.2e}\")\n",
        "    print(f\"   Frecuencia angular ω: {radio_fit['omega']:.6e} rad/s\")\n",
        "    print(f\"   Fase φ: {radio_fit['phi']:.3f} rad\")\n",
        "    print(f\"   Tasa decaimiento γ: {radio_fit['gamma']:.6e} 1/s\")\n",
        "    print(f\"   Periodo ajustado: {radio_fit['period_days']:.2f} días\")\n",
        "    print(f\"   R²: {radio_fit['r_squared']:.4f}\")\n",
        "    print(\"\")\n",
        "    \n",
        "print(\"✅ Ajustes completados exitosamente\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def plot_model_fits(data, xray_fit, radio_fit):\n",
        "    \"\"\"\n",
        "    Grafica los datos originales y los ajustes del modelo\n",
        "    \"\"\"\n",
        "    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 10))\n",
        "    \n",
        "    # X-ray fit\n",
        "    if xray_fit['success']:\n",
        "        ax1.plot(data['time_days'], data['xray_flux'] * 1e11, \n",
        "                 'o', color='#FF1744', markersize=4, alpha=0.5, label='Datos')\n",
        "        ax1.plot(data['time_days'], xray_fit['flux_fit'] * 1e11, \n",
        "                 '-', color='darkred', linewidth=2.5, \n",
        "                 label=f'Ajuste Lense-Thirring (R²={xray_fit[\"r_squared\"]:.3f})')\n",
        "        ax1.set_xlabel('Tiempo (días)', fontsize=12, fontweight='bold')\n",
        "        ax1.set_ylabel('Flujo X-ray (×10⁻¹¹ erg/cm²/s)', fontsize=12, fontweight='bold')\n",
        "        ax1.set_title('Ajuste del Modelo Lense-Thirring: X-ray', fontsize=14, fontweight='bold')\n",
        "        ax1.legend(fontsize=11, loc='upper right')\n",
        "        ax1.grid(True, alpha=0.3)\n",
        "        \n",
        "        # Añadir ecuación\n",
        "        eq_text = f\"Ψ(t) = {xray_fit['A']*1e11:.2f} · sin({xray_fit['omega']:.2e}·t + {xray_fit['phi']:.2f}) · e^(-{xray_fit['gamma']:.2e}·t)\"\n",
        "        ax1.text(0.02, 0.02, eq_text, transform=ax1.transAxes, \n",
        "                 fontsize=9, verticalalignment='bottom', family='monospace',\n",
        "                 bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.8))\n",
        "    \n",
        "    # Radio fit\n",
        "    if radio_fit['success']:\n",
        "        ax2.plot(data['time_days'], data['radio_flux'], \n",
        "                 's', color='#00E676', markersize=4, alpha=0.5, label='Datos')\n",
        "        ax2.plot(data['time_days'], radio_fit['flux_fit'], \n",
        "                 '-', color='darkgreen', linewidth=2.5, \n",
        "                 label=f'Ajuste Lense-Thirring (R²={radio_fit[\"r_squared\"]:.3f})')\n",
        "        ax2.set_xlabel('Tiempo (días)', fontsize=12, fontweight='bold')\n",
        "        ax2.set_ylabel('Flujo Radio (mJy)', fontsize=12, fontweight='bold')\n",
        "        ax2.set_title('Ajuste del Modelo Lense-Thirring: Radio', fontsize=14, fontweight='bold')\n",
        "        ax2.legend(fontsize=11, loc='upper right')\n",
        "        ax2.grid(True, alpha=0.3)\n",
        "        \n",
        "        # Añadir ecuación\n",
        "        eq_text = f\"Ψ(t) = {radio_fit['A']:.2f} · sin({radio_fit['omega']:.2e}·t + {radio_fit['phi']:.2f}) · e^(-{radio_fit['gamma']:.2e}·t)\"\n",
        "        ax2.text(0.02, 0.02, eq_text, transform=ax2.transAxes, \n",
        "                 fontsize=9, verticalalignment='bottom', family='monospace',\n",
        "                 bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.8))\n",
        "    \n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "    \n",
        "    print(\"🎯 Ajuste del modelo verificando Ψ = π · A²eff\")\n",
        "\n",
        "# Graficar ajustes\n",
        "plot_model_fits(data, xray_fit, radio_fit)"
      ]
    },
    {
