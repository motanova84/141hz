        "        '1 Hz\\n(Pulsaciones\\nCardíacas)',\n",
        "        f'f₀\\n{F0_HZ:.5f} Hz\\n(Resonancia\\nCuántico-Consciente)'\n",
        "    ]\n",
        "    \n",
        "    colors = ['#2196F3', '#00BCD4', '#4CAF50', '#FF5722']\n",
        "    \n",
        "    # Graficar en escala logarítmica\n",
        "    positions = np.arange(len(frequencies))\n",
        "    bars = ax.bar(positions, frequencies, color=colors, alpha=0.7, edgecolor='black', linewidth=2)\n",
        "    \n",
        "    # Configurar ejes\n",
        "    ax.set_yscale('log')\n",
        "    ax.set_ylabel('Frecuencia (Hz) - Escala Logarítmica', fontsize=13, fontweight='bold')\n",
        "    ax.set_title('Espectro Armónico: De lo Cosmológico a lo Cuántico-Consciente', \n",
        "                 fontsize=15, fontweight='bold')\n",
        "    ax.set_xticks(positions)\n",
        "    ax.set_xticklabels(labels, fontsize=10, fontweight='bold')\n",
        "    ax.grid(True, which='both', alpha=0.3, axis='y')\n",
        "    \n",
        "    # Añadir líneas conectoras\n",
        "    for i in range(len(frequencies)-1):\n",
        "        ax.plot([positions[i], positions[i+1]], \n",
