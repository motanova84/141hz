{
  "rewrites": [
    { "source": "/results/(.*)", "destination": "/results/$1" },
    { "source": "/scripts/(.*)", "destination": "/scripts/$1" },
    { "source": "/docs/(.*)", "destination": "/docs/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Powered-By", "value": "GWPy + Noesis Ψ" },
        { "key": "X-Frequency", "value": "141.7001 Hz" },
        { "key": "X-Coherence", "value": "Verified" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
